# ---------------------------------------------------------------------------
# 仓库目的：保存两件工作的源码与结论
#   1. math-typeset/   波动方程解析解与差分格式的核对（报告 + 脚本 + 图）
#   2. plugin-design/  dsh-math-tex 插件：设计、证据、实现、测试
# 其余内容按"生成物 / 本地状态 / 无关项目"排除。
# ---------------------------------------------------------------------------

# 依赖与缓存
node_modules/
__pycache__/
*.pyc
.npm/
pnpm-store/

# 会话记录与其解压产物：几十 MB zstd 分帧日志，属于本地状态。
# 需要时用 plugin-design/dsh-math-tex/tools/verify-live.mjs 现场解压。
plugin-design/sessions-decompressed/
*.jsonl.zstd

# LaTeX 编译中间产物（.tex / .pdf / 图 保留）
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.xdv
*.bcf
*.run.xml
*.toc

# 日志与临时文件
*.tmp
*.bak
*.bak-*
.DS_Store
Thumbs.db

# 本地工具安装（gh.exe 等）：15 MB 的二进制，不属于源码
.tools/

# 从 app.asar 抽出来的发行版代码：是"被检查的对象"，不是我们的源码
plugin-design/mathfind/
plugin-design/_asar/
_asar/

# 一次性调试脚本：过程证据，留在磁盘上复查，但不让仓库被几十个 dbg*.mjs 淹没
plugin-design/plugin/dbg*.mjs
plugin-design/plugin/debug-*.mjs
plugin-design/plugin/guard.log
plugin-design/math-guard-test/
plugin-design/math-guard-probe2/

# 与本仓库主题无关的其它探索项目
dsh-maximize/
dsh-window-probe.ps1
extract/
build_interview_doc*.py
characteristic_*.py
characteristic_*.png
domain_of_dependence.*
dl-cache.json
dsh-plugins-survey.json
