{
  "name": "dsh-math-tex",
  "version": "1.2.11",
  "description": "Keeps DSH math derivations readable: prompt rules plus a pre-persistence stream guard that repairs any math region the renderer would paint red.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "katex",
    "markdown",
    "math",
    "latex"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./repair": {
      "default": "./lib/tex-repair.js"
    },
    "./config": {
      "default": "./lib/config.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "tools",
    "docs",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "icon.png",
    "README.md",
    "README.en.md",
    "STATUS.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "test:quick": "node test/guard-test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
